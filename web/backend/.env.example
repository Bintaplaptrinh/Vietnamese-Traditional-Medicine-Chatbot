FPT_API_KEY=your-api-key
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=gemma-4-31B-it
# Disable thinking for bounded Gemma 4 / DeepSeek V4 JSON tasks.
FPT_ENABLE_THINKING=0
# Standalone graph questions use local lexical search; llm opts into paid planning.
KNOWLEDGE_PLANNER=lexical
KNOWLEDGE_GRAPH_PATH=knowledge/dataset-run/dataset_graph.json
HOST=127.0.0.1
PORT=8000

# Server-side JEV decisions and verification, never sent to browser
TYPESAFE_API_KEY=
# Shared API and local context/output caps (context includes input + output).
MODEL_CONTEXT_TOKENS=262144
MODEL_MAX_OUTPUT_TOKENS=32768
MODEL_TIMEOUT_SECONDS=600
# LiquidAI/LFM3-1.7B is loaded alongside Qwen; pin reviewed custom model code.
LFM3_DEVICE=auto
LFM3_REVISION=ac2586a34f1a1c03329dbdcdefabd8b6478ddaa7
LFM3_PREFILL_CHUNK_TOKENS=2048
LFM3_MODEL_PATH=
LFM3_STARTUP_TIMEOUT_SECONDS=600
# Qwen/Qwen3-Reranker-0.6B for graph and hybrid (auto selects CUDA or CPU)
QWEN_RERANKER_DEVICE=auto
QWEN_RERANKER_TIMEOUT_SECONDS=60
# Startup loads local models and runs warmup before serving requests.
QWEN_RERANKER_STARTUP_TIMEOUT_SECONDS=180
# Configure one search provider (SearXNG must enable JSON output)
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
# Optional isolated Crawl4AI Docker API, otherwise uses Jina Reader
CRAWL4AI_URL=

TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# Qdrant/bm25 sparse index. 0 uses plain lexical candidates (not BM25).
KNOWLEDGE_BM25=1
PDF_UPLOAD_MAX_MB=40
INGESTION_MAX_CALLS=160
INGESTION_TIMEOUT_SECONDS=1800
