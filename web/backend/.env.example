FPT_API_KEY=your-api-key
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=gemma-4-31B-it
KNOWLEDGE_GRAPH_PATH=knowledge/dataset-run/dataset_graph.json
HOST=127.0.0.1
PORT=8000

# Server-side JEV decisions and verification, never sent to browser
TYPESAFE_API_KEY=
# Qwen/Qwen3-Reranker-0.6B for graph and hybrid (auto selects CUDA or CPU)
QWEN_RERANKER_DEVICE=auto
QWEN_RERANKER_TIMEOUT_SECONDS=60
# Startup loads local models and runs warmup before serving requests.
QWEN_RERANKER_STARTUP_TIMEOUT_SECONDS=180
# Configure one search provider (SearXNG must enable JSON output)
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
# Optional isolated Crawl4AI Docker API, otherwise uses Jina Reader
CRAWL4AI_URL=

TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# Qdrant/bm25 sparse index. 0 uses plain lexical candidates (not BM25).
KNOWLEDGE_BM25=1
PDF_UPLOAD_MAX_MB=40
INGESTION_MAX_CALLS=160
INGESTION_TIMEOUT_SECONDS=1800
