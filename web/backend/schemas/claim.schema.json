{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ygibiteo:claim:1.0.0",
  "type": "object",
  "required": ["record_id", "subject", "subject_type", "predicate", "object", "object_type", "source", "polarity", "evidence_type", "context", "evidence_ids", "document_id", "review_status", "semantic_support", "ontology_version"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string"},
    "predicate": {"type": "string"},
    "object": {"type": "string", "minLength": 1},
    "object_type": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "polarity": {"enum": ["affirmed", "negated", "unknown"]},
    "evidence_type": {"enum": ["traditional_use_report", "study_finding", "source_recommendation", "terminology", "unknown"]},
    "context": {"type": "object", "required": ["population", "dose", "preparation", "community", "study_model"], "additionalProperties": {"type": ["string", "null"]}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "document_id": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["pending", "accepted", "quarantine", "rejected"]},
    "semantic_support": {"enum": ["unknown", "supported", "contradicted"]},
    "ontology_version": {"const": "1.0.0"}
  }
}
